<UserControl x:Class="HddChecker.App.MetricChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="260">
    <Border Background="#111827" CornerRadius="8" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <TextBlock x:Name="RangeText" DockPanel.Dock="Right" Foreground="#9CA3AF" />
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" Foreground="#F9FAFB" />
            </DockPanel>
            <Canvas x:Name="PlotCanvas" Grid.Row="1" MinHeight="180" ClipToBounds="True" />
            <Grid Grid.Row="2" Margin="48,8,12,0">
                <TextBlock x:Name="FirstDateText" Foreground="#9CA3AF" FontSize="11"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="LastDateText" Foreground="#9CA3AF" FontSize="11"
                           HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
